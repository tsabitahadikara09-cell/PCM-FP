  <property name="styleSheet">
   <string notr="true">QDialog {
    background-color: #2b2b2b;
}
QLabel {
    color: #ffffff;
    background: transparent;
    font-size: 10pt;
}
QLabel[role=&quot;title&quot;] {
    font-weight: bold;
    color: #d0d0d0;
}
QLabel[role=&quot;heading&quot;] {
    font-weight: bold;
    font-size: 11pt;
}
QLabel[role=&quot;arrow&quot;] {
    color: #2f8fdd;
}
QLabel[role=&quot;image&quot;] {
    background-color: #1e1e1e;
    border: 1px solid #555555;
    border-radius: 4px;
    color: #888888;
}
QTabWidget::pane {
    border: 1px solid #555555;
    border-radius: 4px;
    top: -1px;
}
QTabBar::tab {
    background-color: #3c3f41;
    color: #cccccc;
    border: 1px solid #555555;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 8px 22px;
    margin-right: 2px;
    font-size: 10pt;
}
QTabBar::tab:selected {
    background-color: #2f8fdd;
    color: #ffffff;
    font-weight: bold;
}
QTabBar::tab:hover:!selected {
    background-color: #4a4d50;
}
QPushButton {
    background-color: #3c3f41;
    color: #ffffff;
    border: 1px solid #5a5a5a;
    border-radius: 4px;
    min-height: 30px;
    padding: 0 14px;
    font-size: 10pt;
}
QPushButton:hover {
    background-color: #4a4d50;
}
QPushButton:pressed {
    background-color: #2f8fdd;
}
QPushButton:focus {
    border: 1px solid #2f8fdd;
}
QComboBox, QLineEdit, QDoubleSpinBox {
    background-color: #3b3b3b;
    color: #ffffff;
    border: 1px solid #5a5a5a;
    border-radius: 4px;
    min-height: 28px;
    padding: 0 8px;
    font-size: 10pt;
}
QComboBox:focus, QLineEdit:focus, QDoubleSpinBox:focus {
    border: 1px solid #2f8fdd;
}
QComboBox QAbstractItemView {
    background-color: #3b3b3b;
    color: #ffffff;
    selection-background-color: #2f8fdd;
    selection-color: #ffffff;
    border: 1px solid #5a5a5a;
}
QLineEdit[role=&quot;result&quot;] {
    font-weight: bold;
    font-size: 11pt;
}
QTableWidget {
    background-color: #1e1e1e;
    alternate-background-color: #262626;
    color: #ffffff;
    gridline-color: #444444;
    border: 1px solid #555555;
    border-radius: 4px;
    selection-background-color: #2f8fdd;
}
QHeaderView::section {
    background-color: #3c3f41;
    color: #ffffff;
    border: 1px solid #555555;
    padding: 4px;
    font-weight: bold;
}</string>
